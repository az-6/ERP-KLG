{
  "name": "KLG ERPNext Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "frappe",
  "workspaceFolder": "/workspace/development",
  "remoteUser": "frappe",
  "forwardPorts": [8000, 9000, 6787],
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
